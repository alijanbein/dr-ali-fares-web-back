# For now, the hospital site's database (the same value as DATABASE_URL in
# orthopedic-opd-ai-test/backend/.env). Only the doctor_booking_requests table
# is created or used there. Change this line to move to another database.
DATABASE_URL=

# Password for the secretary's inbox at /secretary on the website. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
SECRETARY_KEY=

# Comma-separated website origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:5180

# Set to true when deployed behind a proxy such as Render.
TRUST_PROXY=false
